# Copy this file to .env before `docker compose up -d --build`.
PUBLIC_PORT=8787
APP_BASE_URL=http://127.0.0.1:8787
APP_SECRET=replace-with-a-long-random-production-secret
ADMIN_PASSWORD=
UPDATE_AGENT_SECRET=
CORS_ALLOW_ORIGIN=*
# Set this after the GitHub Actions image is published to use GHCR updates.
# BACKEND_IMAGE=ghcr.io/timshitpig/mantou-toolbox-backend:latest

# Keep true for local WeChat developer-tool testing. Set false in production
# and provide WECHAT_APP_ID / WECHAT_APP_SECRET.
ALLOW_DEVELOPMENT_LOGIN=true
SESSION_TTL_DAYS=30
WECHAT_APP_ID=
WECHAT_APP_SECRET=

DOWNLOAD_ENABLED=true
PARSE_ENABLED=true
QIMAO_ENABLED=true
FANQIE_ENABLED=true
FANQIE_KEYS_CONFIGURED=false
DOWNLOAD_LIMIT=0
REWARDED_AD_ENABLED=false
REWARDED_AD_EVERY_DOWNLOADS=3
CLOUD_DIRECT_LINK_ENABLED=true
REMOTE_METADATA_ENABLED=false
CONTENT_CATALOG_FILE=
CONTENT_PROVIDER_URL=
CONTENT_DIR=./content
IMAGE_PROXY_ALLOWLIST=qimao.com,wtzw.com,fanqienovel.com,fqnovel.com,changdunovel.com
