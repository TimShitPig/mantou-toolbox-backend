# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
APP_BASE_URL=http://127.0.0.1:8787
APP_SECRET=replace-this-with-a-long-random-secret-before-production
ADMIN_PASSWORD=
UPDATE_AGENT_SECRET=
CORS_ALLOW_ORIGIN=*

# Authentication
# Development login is useful with the WeChat developer tool. Set false in production.
ALLOW_DEVELOPMENT_LOGIN=true
SESSION_TTL_DAYS=30
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Download controls
DOWNLOAD_ENABLED=true
PARSE_ENABLED=true
QIMAO_ENABLED=true
FANQIE_ENABLED=true
DOWNLOAD_LIMIT=0
REWARDED_AD_ENABLED=false
REWARDED_AD_EVERY_DOWNLOADS=3
CLOUD_DIRECT_LINK_ENABLED=true

# Optional providers
# Enable remote metadata requests only after the target request domains are available.
REMOTE_METADATA_ENABLED=false
# A JSON file containing authorized local content records. See README.md.
CONTENT_CATALOG_FILE=
# Optional HTTP endpoint that returns { text } or { chapters: [{ title, content }] }.
CONTENT_PROVIDER_URL=
# Comma-separated source domains allowed by the image proxy.
IMAGE_PROXY_ALLOWLIST=qimao.com,wtzw.com,fanqienovel.com,fqnovel.com,changdunovel.com
